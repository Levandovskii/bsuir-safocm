-- Quartus II generated Memory Initialization File (.mif)

WIDTH=9;
DEPTH=128;

ADDRESS_RADIX=UNS;
DATA_RADIX=BIN;

CONTENT BEGIN
	0    :   001111101;
	1    :   000000101;
	2    :   110001010;
	[3..4]  :   000000000;
	5    :   000001000;
	6    :   110000010;
	7    :   000000000;
	8    :   000001000;
	9    :   111000011;
	10   :   001000000;
	11   :   000000100;
	[12..127]  :   000000000;
END;
